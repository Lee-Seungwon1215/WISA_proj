{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lee-Seungwon1215/WISA_proj/docs/baselines/baseline-result-v1.schema.json",
  "title": "CT-KAT same-corpus baseline result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "suite_id",
    "created_at",
    "manifest",
    "manifest_sha256",
    "ctkat_commit",
    "git_dirty",
    "run_id",
    "run_kind",
    "human_review_gate",
    "automated_premeasurement_gate",
    "tool_id",
    "host",
    "rows",
    "promotion_ready",
    "errors",
    "backend"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "kind": {"const": "ctkat-same-corpus-baseline"},
    "suite_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "manifest": {"type": "string"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ctkat_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "git_dirty": {"type": "boolean"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "run_kind": {"enum": ["engineering", "pilot", "final"]},
    "human_review_gate": {"type": ["object", "null"]},
    "automated_premeasurement_gate": {"type": ["object", "null"]},
    "tool_id": {
      "enum": ["official_dudect", "timecop", "microwalk_pin", "capability_probe"]
    },
    "host": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "system",
        "machine",
        "timing_evidence",
        "cpu_model",
        "machine_id_sha256",
        "boot_id_sha256",
        "cpu_affinity",
        "governor",
        "virtualization"
      ],
      "properties": {
        "system": {"type": "string"},
        "machine": {"type": "string"},
        "timing_evidence": {"type": "boolean"},
        "cpu_model": {"type": "string", "minLength": 1},
        "machine_id_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "boot_id_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cpu_affinity": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "governor": {"type": ["string", "null"]},
        "virtualization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vm", "container"],
          "properties": {
            "vm": {"type": "string"},
            "container": {"type": "string"}
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {"$ref": "#/$defs/row"}
    },
    "promotion_ready": {"type": "boolean"},
    "errors": {
      "type": "array",
      "items": {"type": "string"}
    },
    "backend": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "compiler_identity": {"$ref": "#/$defs/compilerIdentity"}
      }
    }
  },
  "$defs": {
    "nullableNumber": {"type": ["number", "null"]},
    "nullableInteger": {"type": ["integer", "null"], "minimum": 0},
    "linkedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "compilerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "requested",
        "invocation_path",
        "resolved_path",
        "sha256",
        "version_argv",
        "version_returncode",
        "version_stdout",
        "version_stderr"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "requested": {"type": "string", "minLength": 1},
        "invocation_path": {"type": "string", "minLength": 1},
        "resolved_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "version_argv": {"type": "array", "items": {"type": "string"}},
        "version_returncode": {"const": 0},
        "version_stdout": {"type": "string", "minLength": 1},
        "version_stderr": {"type": "string"}
      }
    },
    "timecopEvidence": {
      "type": "object",
      "required": [
        "compile_command",
        "compile_argv",
        "compile_workdir",
        "source_sha256",
        "linked_sources",
        "argv",
        "returncode",
        "timed_out",
        "binary_sha256",
        "log_sha256",
        "stdout_sha256",
        "stderr_sha256",
        "findings",
        "finding_signatures"
      ],
      "properties": {
        "compile_command": {"type": "string", "minLength": 1},
        "compile_argv": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string"}
        },
        "compile_workdir": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "linked_sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/linkedSource"}
        },
        "argv": {"type": "array", "items": {"type": "string"}},
        "returncode": {"type": "integer"},
        "timed_out": {"type": "boolean"},
        "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "findings": {"type": "array", "items": {"type": "object"}},
        "finding_signatures": {"type": "array", "items": {"type": "object"}}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "tool_id",
        "capability",
        "execution_status",
        "outcome",
        "known_issue_match",
        "candidate_count",
        "reviewed_concern_count",
        "setup_seconds",
        "config_loc",
        "adapter_loc",
        "runtime_seconds",
        "peak_memory_kib",
        "artifact_bytes",
        "human_triage_minutes",
        "reviewer_agreement",
        "disposition_stability",
        "evidence"
      ],
      "properties": {
        "case_id": {"type": "string"},
        "tool_id": {
          "enum": ["official_dudect", "timecop", "microwalk_pin"]
        },
        "capability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"enum": ["supported", "unsupported"]},
            "reason": {"type": "string"}
          }
        },
        "execution_status": {
          "enum": ["not-run", "completed", "crash", "timeout", "error"]
        },
        "outcome": {
          "enum": ["finding", "no-finding", "inconclusive", "not-run"]
        },
        "known_issue_match": {"type": ["boolean", "null"]},
        "candidate_count": {"$ref": "#/$defs/nullableInteger"},
        "reviewed_concern_count": {"$ref": "#/$defs/nullableInteger"},
        "setup_seconds": {"$ref": "#/$defs/nullableNumber"},
        "config_loc": {"type": "integer", "minimum": 0},
        "adapter_loc": {"type": "integer", "minimum": 0},
        "runtime_seconds": {"$ref": "#/$defs/nullableNumber"},
        "peak_memory_kib": {"$ref": "#/$defs/nullableInteger"},
        "artifact_bytes": {"$ref": "#/$defs/nullableInteger"},
        "human_triage_minutes": {"$ref": "#/$defs/nullableNumber"},
        "reviewer_agreement": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "disposition_stability": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tool_id": {"const": "timecop"},
              "execution_status": {"const": "completed"}
            },
            "required": ["tool_id", "execution_status"]
          },
          "then": {
            "properties": {
              "evidence": {"$ref": "#/$defs/timecopEvidence"}
            }
          }
        }
      ]
    }
  }
}
