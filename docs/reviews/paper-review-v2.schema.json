{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctkat.invalid/schemas/paper-review-v2.schema.json",
  "title": "CT-KAT independent paper review packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "review_id", "status", "title", "review_phase",
    "final_evidence_root_sha256",
    "source_revision_policy", "scope", "threat_model", "secret_origin",
    "observed_dependency", "declassification_predicate", "public_transcript",
    "security_argument", "known_limitations", "evidence", "expected_evidence",
    "reviewers", "expiry_conditions"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "review_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "status": {"enum": ["pending", "reviewed", "disputed", "expired"]},
    "title": {"type": "string", "minLength": 1},
    "review_phase": {"enum": ["pre-measurement", "post-measurement"]},
    "final_evidence_root_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ],
      "description": "Canonical final-evidence root approved by a post-measurement packet. It remains null before a candidate bundle exists; each reviewer evidence-manifest digest binds this field."
    },
    "source_revision_policy": {"const": "exact-clean-git-head-at-review"},
    "scope": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["target", "harness", "build_scope"],
        "properties": {
          "target": {"type": "string", "minLength": 1},
          "harness": {"type": "string", "minLength": 1},
          "build_scope": {"type": "string", "minLength": 1}
        }
      }
    },
    "threat_model": {"type": "string", "minLength": 1},
    "secret_origin": {"type": "string", "minLength": 1},
    "observed_dependency": {"type": "string", "minLength": 1},
    "declassification_predicate": {"type": "string", "minLength": 1},
    "public_transcript": {"type": "string", "minLength": 1},
    "security_argument": {"type": "string", "minLength": 1},
    "known_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "expected_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "id", "human_reviewer", "affiliation_or_role",
          "independent_from_artifact_author", "decision", "reviewed_at",
          "reviewed_commit", "evidence_manifest_sha256", "notes"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
          "human_reviewer": {"const": true},
          "affiliation_or_role": {"type": "string", "minLength": 1},
          "independent_from_artifact_author": {"const": true},
          "decision": {"enum": ["approve", "reject", "abstain"]},
          "reviewed_at": {"type": "string", "format": "date-time"},
          "reviewed_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "evidence_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the canonical packet policy (excluding status/reviewers) and every evidence file's path/hash."
          },
          "notes": {"type": "string", "minLength": 1}
        }
      }
    },
    "expiry_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
