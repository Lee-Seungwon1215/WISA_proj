{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctkat.invalid/schemas/final-evidence-root-v1.schema.json",
  "title": "CT-KAT canonical final evidence root",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "algorithm",
    "bundle_id",
    "measurement_commit",
    "verification_commit",
    "artifact_count",
    "artifacts",
    "final_evidence_root_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "ctkat-final-evidence-root"},
    "algorithm": {"const": "sha256"},
    "bundle_id": {"type": "string", "minLength": 1},
    "measurement_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "verification_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifact_count": {"type": "integer", "minimum": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_path", "role", "bytes", "sha256"],
        "properties": {
          "logical_path": {"type": "string", "minLength": 1},
          "role": {
            "enum": [
              "measurement-bundle",
              "host-tree-hash-manifest",
              "assembly-evidence-bundle",
              "unblinding-record",
              "blinded-analysis-output",
              "named-analysis-output"
            ]
          },
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "final_evidence_root_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of canonical JSON for every other field in this object."
    }
  }
}
