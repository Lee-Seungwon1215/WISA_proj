{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctkat.invalid/schemas/unblinding-record-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "bundle_id", "scope", "custodian_id",
    "analyst_id", "blinded_at", "blinded_analysis_completed_at",
    "blinded_analysis_manifest_sha256", "unblinded_at", "label_map",
    "host_transfers", "attestations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "ctkat-analysis-unblinding-record"},
    "bundle_id": {"type": "string", "minLength": 1},
    "scope": {"const": "result-analyst-label-blinding"},
    "custodian_id": {"type": "string", "minLength": 1},
    "analyst_id": {"type": "string", "minLength": 1},
    "blinded_at": {"type": "string", "format": "date-time"},
    "blinded_analysis_completed_at": {"type": "string", "format": "date-time"},
    "blinded_analysis_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unblinded_at": {"type": "string", "format": "date-time"},
    "label_map": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["opaque_label", "component", "target"],
        "properties": {
          "opaque_label": {"type": "string", "minLength": 1},
          "component": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1}
        }
      }
    },
    "host_transfers": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["host_id", "hash_manifest_sha256", "received_at", "verified"],
        "properties": {
          "host_id": {"type": "string", "minLength": 1},
          "hash_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "received_at": {"type": "string", "format": "date-time"},
          "verified": {"const": true}
        }
      }
    },
    "attestations": {
      "type": "object", "additionalProperties": false,
      "required": [
        "custodian_created_opaque_labels_before_analysis",
        "analyst_saw_only_opaque_labels_before_unblinding",
        "unblinding_happened_after_frozen_analysis_completed"
      ],
      "properties": {
        "custodian_created_opaque_labels_before_analysis": {"const": true},
        "analyst_saw_only_opaque_labels_before_unblinding": {"const": true},
        "unblinding_happened_after_frozen_analysis_completed": {"const": true}
      }
    }
  }
}
