static int ctkat_signature_result_valid(int return_code, size_t output_length) {
    return return_code == 0 &&
           output_length >= (size_t)CTKAT_SIG_LENGTH_MIN &&
           output_length <= (size_t)CTKAT_SIG_LENGTH_MAX;
}

static int ctkat_alloc(uint8_t **out, size_t count, size_t width) {
    if (width != 0 && count > SIZE_MAX / width) return -1;
    *out = (uint8_t *)malloc(count * width);
    return *out == NULL ? -1 : 0;
}

int main(int argc, char **argv) {
    struct ctkat_options options;
    if (ctkat_parse_options(argc, argv, &options) != 0) {
        fprintf(
            stderr,
            "usage: %s [nonzero-decimal-seed [target|aa|placebo|positive "
            "effect_ticks measurements_or_0]]\n",
            argv[0]
        );
        return 2;
    }
    ctkat_prng_init(options.seed);
    int exit_status = 0;
    size_t measured_signature_contract_failures = 0;

    uint8_t *pool0_sk = NULL;
    uint8_t *pool1_sk = NULL;
    uint8_t *pool0_msg = NULL;
    uint8_t *pool1_msg = NULL;
    if (ctkat_alloc(&pool0_sk, CTKAT_POOL_SIZE, CTKAT_SK_BYTES) != 0 ||
        ctkat_alloc(&pool1_sk, CTKAT_POOL_SIZE, CTKAT_SK_BYTES) != 0 ||
        ctkat_alloc(&pool0_msg, CTKAT_POOL_SIZE, CTKAT_SIGN_MSG_LEN) != 0 ||
        ctkat_alloc(&pool1_msg, CTKAT_POOL_SIZE, CTKAT_SIGN_MSG_LEN) != 0) {
        fprintf(stderr, "timing-harness-v2: input pool allocation failed\n");
        free(pool0_sk); free(pool1_sk); free(pool0_msg); free(pool1_msg);
        return 3;
    }

    uint8_t pk_fixed[CTKAT_PK_BYTES];
    uint8_t sk_fixed[CTKAT_SK_BYTES];
{% if sign_leak_target | default("sk") == "sk" %}
    uint8_t pk_tmp[CTKAT_PK_BYTES];
    uint8_t sk_tmp[CTKAT_SK_BYTES];
{% endif %}
    uint8_t msg_fixed[CTKAT_SIGN_MSG_LEN];
    uint8_t gate_sig[CTKAT_SIG_BYTES];
    uint8_t sk_work[CTKAT_SK_BYTES];
    uint8_t msg_work[CTKAT_SIGN_MSG_LEN];
    uint8_t sig_work[CTKAT_SIG_BYTES];
    size_t siglen = 0;
    ctkat_rand_bytes(msg_fixed, sizeof(msg_fixed));
    int fixed_keypair_rc = {{ prefix }}crypto_sign_keypair(pk_fixed, sk_fixed);
    if (fixed_keypair_rc != 0) {
        fprintf(stderr,
                "timing-harness-v2: correctness gate keypair failed rc=%d\n",
                fixed_keypair_rc);
        exit_status = 4;
        goto cleanup;
    }

    /* Execution gate, deliberately outside every timed region: the exact
     * detached-signature API under test must first produce a contract-valid
     * signature that verifies under the corresponding public key. */
    size_t gate_siglen = 0;
    int gate_sign_rc = {{ prefix }}crypto_sign_signature(
        gate_sig, &gate_siglen, msg_fixed, sizeof(msg_fixed), sk_fixed
    );
    if (!ctkat_signature_result_valid(gate_sign_rc, gate_siglen)) {
        fprintf(stderr,
                "timing-harness-v2: correctness gate signing failed "
                "rc=%d output_length=%zu expected=[%zu,%zu]\n",
                gate_sign_rc,
                gate_siglen,
                (size_t)CTKAT_SIG_LENGTH_MIN,
                (size_t)CTKAT_SIG_LENGTH_MAX);
        exit_status = 5;
        goto cleanup;
    }
    int gate_verify_rc = {{ prefix }}crypto_sign_verify(
        gate_sig, gate_siglen, msg_fixed, sizeof(msg_fixed), pk_fixed
    );
    if (gate_verify_rc != 0) {
        fprintf(stderr,
                "timing-harness-v2: correctness gate verification failed rc=%d\n",
                gate_verify_rc);
        exit_status = 6;
        goto cleanup;
    }

    /* Both pools are materialized before measurement. */
    for (size_t p = 0; p < CTKAT_POOL_SIZE; p++) {
{% if sign_leak_target | default("sk") == "msg" %}
        memcpy(CTKAT_SLOT(pool0_sk, p, CTKAT_SK_BYTES), sk_fixed, CTKAT_SK_BYTES);
        memcpy(CTKAT_SLOT(pool1_sk, p, CTKAT_SK_BYTES), sk_fixed, CTKAT_SK_BYTES);
        memcpy(CTKAT_SLOT(pool0_msg, p, CTKAT_SIGN_MSG_LEN),
               msg_fixed, CTKAT_SIGN_MSG_LEN);
        uint8_t *pool_msg = CTKAT_SLOT(pool1_msg, p, CTKAT_SIGN_MSG_LEN);
        ctkat_rand_bytes(pool_msg, CTKAT_SIGN_MSG_LEN);
        size_t pool_siglen = 0;
        int pool_sign_rc = {{ prefix }}crypto_sign_signature(
            gate_sig, &pool_siglen, pool_msg, CTKAT_SIGN_MSG_LEN, sk_fixed
        );
        if (!ctkat_signature_result_valid(pool_sign_rc, pool_siglen)) {
            fprintf(stderr,
                    "timing-harness-v2: message-pool signing gate failed "
                    "index=%zu rc=%d output_length=%zu\n",
                    p, pool_sign_rc, pool_siglen);
            exit_status = 10;
            goto cleanup;
        }
        if ({{ prefix }}crypto_sign_verify(
                gate_sig, pool_siglen, pool_msg, CTKAT_SIGN_MSG_LEN, pk_fixed) != 0) {
            fprintf(stderr,
                    "timing-harness-v2: message-pool verification gate failed "
                    "index=%zu\n",
                    p);
            exit_status = 11;
            goto cleanup;
        }
{% else %}
        memcpy(CTKAT_SLOT(pool0_sk, p, CTKAT_SK_BYTES), sk_fixed, CTKAT_SK_BYTES);
        memcpy(CTKAT_SLOT(pool0_msg, p, CTKAT_SIGN_MSG_LEN),
               msg_fixed, CTKAT_SIGN_MSG_LEN);
        int pool_keypair_rc = {{ prefix }}crypto_sign_keypair(pk_tmp, sk_tmp);
        if (pool_keypair_rc != 0) {
            fprintf(stderr,
                    "timing-harness-v2: pool keypair failed index=%zu rc=%d\n",
                    p,
                    pool_keypair_rc);
            exit_status = 7;
            goto cleanup;
        }
        size_t pool_siglen = 0;
        int pool_sign_rc = {{ prefix }}crypto_sign_signature(
            gate_sig, &pool_siglen, msg_fixed, sizeof(msg_fixed), sk_tmp
        );
        if (!ctkat_signature_result_valid(pool_sign_rc, pool_siglen)) {
            fprintf(stderr,
                    "timing-harness-v2: key-pool signing gate failed "
                    "index=%zu rc=%d output_length=%zu\n",
                    p, pool_sign_rc, pool_siglen);
            exit_status = 10;
            goto cleanup;
        }
        if ({{ prefix }}crypto_sign_verify(
                gate_sig, pool_siglen, msg_fixed, sizeof(msg_fixed), pk_tmp) != 0) {
            fprintf(stderr,
                    "timing-harness-v2: key-pool verification gate failed index=%zu\n",
                    p);
            exit_status = 11;
            goto cleanup;
        }
        memcpy(CTKAT_SLOT(pool1_sk, p, CTKAT_SK_BYTES), sk_tmp, CTKAT_SK_BYTES);
        memcpy(CTKAT_SLOT(pool1_msg, p, CTKAT_SIGN_MSG_LEN),
               msg_fixed, CTKAT_SIGN_MSG_LEN);
{% endif %}
    }

    for (size_t i = 0; i < CTKAT_WARMUP; i++) {
        size_t p = i % CTKAT_POOL_SIZE;
        unsigned int side = (unsigned int)(i & 1U);
        ctkat_select_bytes(
            sk_work,
            CTKAT_SLOT(pool0_sk, p, CTKAT_SK_BYTES),
            CTKAT_SLOT(pool1_sk, p, CTKAT_SK_BYTES),
            CTKAT_SK_BYTES,
            side
        );
        ctkat_select_bytes(
            msg_work,
            CTKAT_SLOT(pool0_msg, p, CTKAT_SIGN_MSG_LEN),
            CTKAT_SLOT(pool1_msg, p, CTKAT_SIGN_MSG_LEN),
            CTKAT_SIGN_MSG_LEN,
            side
        );
        siglen = 0;
        int warmup_rc = {{ prefix }}crypto_sign_signature(
            sig_work, &siglen, msg_work, sizeof(msg_work), sk_work
        );
        if (!ctkat_signature_result_valid(warmup_rc, siglen)) {
            fprintf(stderr,
                    "timing-harness-v2: warmup signing failed index=%zu "
                    "rc=%d output_length=%zu expected=[%zu,%zu]\n",
                    i,
                    warmup_rc,
                    siglen,
                    (size_t)CTKAT_SIG_LENGTH_MIN,
                    (size_t)CTKAT_SIG_LENGTH_MAX);
            exit_status = 8;
            goto cleanup;
        }
    }
    uint64_t setup_rng_calls = ctkat_randombytes_calls;

    for (size_t i = 0; i < options.measurements; i++) {
        int cls = (int)((ctkat_label_next() >> 32) & 1ULL);
        size_t p = (size_t)(ctkat_select_next() % CTKAT_POOL_SIZE);
        int data_class =
            (options.mode == CTKAT_MODE_TARGET || options.mode == CTKAT_MODE_PLACEBO)
                ? cls
                : 0;
        ctkat_select_bytes(
            sk_work,
            CTKAT_SLOT(pool0_sk, p, CTKAT_SK_BYTES),
            CTKAT_SLOT(pool1_sk, p, CTKAT_SK_BYTES),
            CTKAT_SK_BYTES,
            (unsigned int)data_class
        );
        ctkat_select_bytes(
            msg_work,
            CTKAT_SLOT(pool0_msg, p, CTKAT_SIGN_MSG_LEN),
            CTKAT_SLOT(pool1_msg, p, CTKAT_SIGN_MSG_LEN),
            CTKAT_SIGN_MSG_LEN,
            (unsigned int)data_class
        );
        if (options.mode == CTKAT_MODE_PLACEBO) {
            /* Keep branchless class setup but normalize the measured inputs
             * in the same work buffers used by every other protocol mode. */
            memcpy(sk_work, sk_fixed, CTKAT_SK_BYTES);
            memcpy(msg_work, msg_fixed, CTKAT_SIGN_MSG_LEN);
        }
        CTKAT_BARRIER();

        uint32_t aux0 = 0, aux1 = 0;
        siglen = 0;
        uint64_t t0 = ctkat_now(&aux0);
        int sig_rc = {{ prefix }}crypto_sign_signature(
            sig_work, &siglen, msg_work, sizeof(msg_work), sk_work
        );
        CTKAT_USE(sig_rc);
        if (options.mode == CTKAT_MODE_POSITIVE && cls == 1) {
            ctkat_inject_delay(options.effect_ticks);
        }
        uint64_t t1 = ctkat_now(&aux1);

        int sig_valid = ctkat_signature_result_valid(sig_rc, siglen);
        volatile uint64_t sink = (uint64_t)(unsigned int)sig_rc ^ (uint64_t)siglen;
        size_t sink_len = sig_valid ? siglen : 0;
        for (size_t j = 0; j < sink_len; j++) sink ^= sig_work[j];
        CTKAT_USE(sink);
        ctkat_store_timing(i, cls, t0, t1, aux0, aux1, siglen, sig_rc);
        if (!sig_valid) {
            measured_signature_contract_failures++;
        }
    }

    ctkat_emit_trace(options.measurements);
    ctkat_emit_metadata(&options, setup_rng_calls);
    fprintf(
        stderr,
        "CTKAT-HARNESS-META signature_length_contract={{ signature_length_contract }} "
        "signature_length_min=%zu signature_length_max=%zu "
        "signature_correctness_gate=passed signature_return_code_recorded=true "
        "measured_signature_contract_failures=%zu\n",
        (size_t)CTKAT_SIG_LENGTH_MIN,
        (size_t)CTKAT_SIG_LENGTH_MAX,
        measured_signature_contract_failures
    );
    if (measured_signature_contract_failures != 0) {
        fprintf(stderr,
                "timing-harness-v2: measured signature contract failed "
                "samples=%zu\n",
                measured_signature_contract_failures);
        exit_status = 9;
    }

cleanup:
    free(pool0_sk); free(pool1_sk); free(pool0_msg); free(pool1_msg);
    return exit_status;
}
