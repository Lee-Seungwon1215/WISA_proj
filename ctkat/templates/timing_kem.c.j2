        "corpus_seed=%llu fixed_sk_sha3_256=%s "
        "class0_ct_sha3_256=%s class1_ct_sha3_256=%s\n",
        (unsigned long long)CTKAT_SEED,
        sk_digest_hex,
        class0_digest_hex,
        class1_digest_hex
    );
{% elif leak_target | default("sk") == "operand_bin" -%}
{% if operand_v3 -%}
    fprintf(
        stderr,
        "CTKAT-HARNESS-META axis=operand_bin key_policy=fixed "
        "class_contract=frozen-public-coefficient-bins "
        "class0_coefficients=0-63 class1_coefficients=3265-3328 "
        "setup_contract=same-address-branchless-v3 "
        "class_address_policy=fixed-sk-and-shared-ct-work "
        "placebo_coefficient=1664 placebo_target_path=valid-decapsulation "
        "setup_return_codes=checked coefficient_witness=all-bin-members "
        "measured_dec_contract_failures=%zu corpus_seed=%llu\n",
        measured_dec_contract_failures,
        (unsigned long long)CTKAT_SEED
    );
{% else -%}
    fprintf(
        stderr,
        "CTKAT-HARNESS-META axis=operand_bin key_policy=fixed "
        "class_contract=frozen-public-coefficient-bins "
        "class0_coefficients=0-63 class1_coefficients=3265-3328 "
        "corpus_seed=%llu\n",
        (unsigned long long)CTKAT_SEED
    );
{% endif -%}
{% endif %}
    ctkat_emit_metadata(&options, setup_rng_calls);
{% if operand_v3 -%}
    if (measured_dec_contract_failures != 0) {
        fprintf(stderr,
                "timing-harness-v2: measured decapsulation contract failed "
                "samples=%zu\n",
                measured_dec_contract_failures);
        return 6;
    }
{% else -%}
    free(pool0_sk); free(pool1_sk); free(pool0_ct); free(pool1_ct);
{% endif -%}
    return 0;
}
